{
  "name": "otpremaops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:all": "concurrently -k \"pnpm dev\" \"pnpm worker\"",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx src/jobs/worker.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src scripts tests next.config.ts drizzle.config.ts vitest.config.ts playwright.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.2",
    "csv-parse": "7.0.2",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^0.468.0",
    "next": "16.3.6",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "server-only": "0.0.1",
    "exceljs": "^4.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": { "overrides": { "uuid": "11.1.1" } }
}
